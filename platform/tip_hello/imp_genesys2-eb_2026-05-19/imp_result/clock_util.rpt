# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells pjtag_rtck_IBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y2 [get_cells i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clkout1_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y76 [get_ports external_clk_0]
set_property LOC IOB_X1Y75 [get_ports external_clk_0_pair]
set_property LOC IOB_X0Y259 [get_ports pjtag_rtck]

# Clock net "pjtag_rtck_IBUF_BUFG" driven by instance "pjtag_rtck_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_pjtag_rtck_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_pjtag_rtck_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="pjtag_rtck_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_pjtag_rtck_IBUF_BUFG}] -add {CLOCKREGION_X0Y4:CLOCKREGION_X0Y4 CLOCKREGION_X0Y5:CLOCKREGION_X0Y5}
#endgroup

# Clock net "i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clk_50000000" driven by instance "i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clkout1_buf" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clk_50000000}
add_cells_to_pblock [get_pblocks  {CLKAG_i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clk_50000000}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clk_50000000"}]]]
resize_pblock [get_pblocks {CLKAG_i_platform/i_pll0/i_xilinx_clock_pll_0/inst/clk_50000000}] -add {CLOCKREGION_X0Y3:CLOCKREGION_X0Y3 CLOCKREGION_X0Y4:CLOCKREGION_X0Y4 CLOCKREGION_X0Y5:CLOCKREGION_X0Y5 CLOCKREGION_X1Y4:CLOCKREGION_X1Y4 CLOCKREGION_X1Y5:CLOCKREGION_X1Y5}
#endgroup
